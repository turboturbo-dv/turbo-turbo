<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Game install location. Override with: dotnet build -p:GameDir="C:\path\to\Derail Valley" -->
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Derail Valley</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <PackageReference Include="Shouldly" Version="4.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- UnityEngine.CoreModule for Color / Mathf, matching the mod project
         (copied to output - the xUnit discovery host needs it beside the dll) -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\DerailValley_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- model under test (owned by the WorkBench project) -->
    <Compile Include="..\WorkBench\Assets\Shimmer\ExhaustSmokeModel.cs" Link="ExhaustSmokeModel.cs" />
    <Compile Include="..\TurboTurbo\Modeling\TurboModel.cs" Link="TurboModel.cs" />
  </ItemGroup>
</Project>
